PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.dq3oric.mongodb.net/learnup_quiz?retryWrites=true&w=majority

# Token signing secret. If unset, one is generated into .jwt-secret on first start.
JWT_SECRET=

# Default admin account created on first start (when the admins collection is empty)

# Optional: restrict CORS to these origins (comma-separated) by setting CORS_RESTRICT=true
CLIENT_URL=http://localhost:5173
CORS_RESTRICT=false
