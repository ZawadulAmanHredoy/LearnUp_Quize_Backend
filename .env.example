PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.dq3oric.mongodb.net/learnup_quiz?retryWrites=true&w=majority

# Token signing secret. If unset, one is generated into .jwt-secret on first start.
JWT_SECRET=

# Admin login. When ADMIN_PASSWORD is set, the account is created or updated to match on every start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-the-event

# Optional: restrict CORS to these origins (comma-separated) by setting CORS_RESTRICT=true
CLIENT_URL=http://localhost:5173
CORS_RESTRICT=false

# Largest media upload (MB) and where the server keeps its local copy of uploaded media
MAX_UPLOAD_MB=200
# MEDIA_CACHE_DIR=./media-cache
